---
// `withBase`, not `href`: the isActive helper below takes a parameter called `href`, and
// importing the helper under its own name would shadow it inside that function.
import { href as withBase, routePath } from '../lib/site';

const path = routePath(Astro.url.pathname).replace(/\/$/, '');

const sections: { title: string; links: { label: string; href: string }[] }[] = [
	{
		title: 'Getting started',
		links: [
			{ label: 'Overview', href: '/docs/' },
			{ label: 'Intro', href: '/docs/intro/' },
			{ label: 'Install', href: '/docs/install/' },
			{ label: 'Quickstart', href: '/docs/quickstart/' },
			{ label: 'CLI reference', href: '/docs/cli/' },
		],
	},
	{
		title: 'The seven tasks',
		links: [
			{ label: 'What gets generated', href: '/docs/generated-suite/' },
			{ label: 'Next.js mode', href: '/docs/nextjs/' },
			{ label: 'Expo / React Native', href: '/docs/expo/' },
			{ label: 'Extending a suite', href: '/docs/extending/' },
			{ label: 'Case study: a whole app', href: '/docs/case-study/' },
		],
	},
	{
		title: 'Recipes',
		links: [
			{ label: 'All recipes', href: '/docs/recipes/' },
			{ label: 'Your first suite', href: '/docs/recipes/first-suite/' },
			{ label: 'Next.js adoption', href: '/docs/recipes/nextjs-adoption/' },
			{ label: 'Colocated specs', href: '/docs/recipes/colocated-specs/' },
			{ label: 'Mocks with real shapes', href: '/docs/recipes/mocking-data-and-actions/' },
			{ label: 'Compound parts', href: '/docs/recipes/compound-components/' },
			{ label: 'Route e2e', href: '/docs/recipes/route-e2e/' },
			{ label: 'Load pipes with crust', href: '/docs/recipes/crust-load-pipes/' },
			{ label: 'Wire it into CI', href: '/docs/recipes/ci-integration/' },
			{ label: 'Triage the findings', href: '/docs/recipes/triage-findings/' },
			{ label: 'Safe regeneration', href: '/docs/recipes/safe-regeneration/' },
		],
	},
	{
		title: 'Agent skills',
		links: [
			{ label: 'Overview', href: '/docs/agent-skills/' },
			{ label: 'MCP server', href: '/docs/mcp/' },
			{ label: 'Suite generation', href: '/docs/agent-skills/suite-generation/' },
			{ label: 'Specs and findings', href: '/docs/agent-skills/specs-and-findings/' },
			{ label: 'Route tests, load, native and the API', href: '/docs/agent-skills/e2e-load-and-api/' },
		],
	},
	{
		title: 'Reference',
		links: [
			{ label: 'Architecture', href: '/docs/architecture/' },
			{ label: 'Limits & troubleshooting', href: '/docs/limits/' },
		],
	},
];

const isActive = (href: string) => {
	const clean = href.replace(/\/$/, '');
	return path === clean;
};
---

<aside class="sidebar" aria-label="Docs navigation">
	<nav>
		{
			sections.map((section) => (
				<div class="section">
					<h4>{section.title}</h4>
					<ul>
						{section.links.map((l) => (
							<li>
								<a href={withBase(l.href)} class:list={[{ active: isActive(l.href) }]}>
									{l.label}
								</a>
							</li>
						))}
					</ul>
				</div>
			))
		}
	</nav>
</aside>

<style>
	.sidebar {
		font-size: 0.95rem;
	}
	.sidebar nav {
		display: flex;
		flex-direction: column;
		gap: 1.75rem;
	}
	.section h4 {
		font-size: 0.75rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--fg-muted);
		font-weight: 600;
		margin: 0 0 0.6rem;
	}
	ul {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
	}
	li {
		margin: 0;
	}
	a {
		display: block;
		padding: 0.4rem 0.6rem;
		border-radius: 6px;
		color: var(--fg-muted);
		border-left: 2px solid transparent;
	}
	a:hover {
		color: var(--fg);
		background: var(--bg-soft);
	}
	a.active {
		color: var(--accent);
		background: var(--bg-soft);
		border-left-color: var(--accent);
		font-weight: 500;
	}
</style>
