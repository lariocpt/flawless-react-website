---
import { href, routePath } from '../lib/site';

// routePath, not Astro.url.pathname: under a base-path deploy the pathname INCLUDES the
// base, so `path.startsWith('/docs')` would never match and every nav item would render
// inactive.
const path = routePath(Astro.url.pathname);
const isActive = (prefix: string) =>
	prefix === '/' ? path === '/' : path.startsWith(prefix);
---

<header class="site-header">
	<div class="container bar">
		<a href={href('/')} class="brand" aria-label="flawless-react home">
			<span class="mark" aria-hidden="true">🔬</span>
			<span class="wordmark">flawless-react</span>
		</a>
		<nav class="nav" aria-label="Primary">
			<a href={href('/docs/intro/')} class:list={[{ active: isActive('/docs') && !isActive('/docs/generated-suite') && !isActive('/docs/recipes') }]}>Docs</a>
			<a href={href('/docs/quickstart/')} class:list={[{ active: path === '/docs/quickstart' }]}>Quickstart</a>
			<a href={href('/docs/recipes/')} class:list={[{ active: isActive('/docs/recipes') }]}>Recipes</a>
			<a href={href('/docs/cli/')} class:list={[{ active: path === '/docs/cli' }]}>CLI</a>
		</nav>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: rgba(13, 17, 23, 0.78);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border-bottom: 1px solid var(--border);
	}
	.bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		height: 60px;
	}
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		color: var(--fg);
		font-weight: 700;
		font-size: 1.1rem;
		letter-spacing: -0.01em;
	}
	.brand:hover {
		color: var(--accent);
	}
	.mark {
		font-size: 1.35rem;
		line-height: 1;
	}
	.wordmark {
		font-family: var(--font-mono);
	}
	.nav {
		display: flex;
		align-items: center;
		gap: 0.25rem;
	}
	.nav a {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		color: var(--fg-muted);
		padding: 0.5rem 0.85rem;
		border-radius: 8px;
		font-size: 0.95rem;
		font-weight: 500;
	}
	.nav a:hover {
		color: var(--fg);
		background: var(--bg-soft);
	}
	.nav a.active {
		color: var(--accent);
	}
	.github svg {
		opacity: 0.7;
	}
	@media (max-width: 600px) {
		/* Brand and four links do not fit one row: at a 400px viewport the bar has 352px,
		   the wordmark takes ~160 of them and the nav needs 254, so the nav was pushed to
		   x=169 and every page scrolled sideways to 423px. The nav takes a row of its own
		   rather than the document growing wider than the device. */
		.bar {
			height: auto;
			flex-wrap: wrap;
			row-gap: 0.35rem;
			padding: 0.55rem 0 0.6rem;
		}
		.nav {
			/* 240px viewports are reachable (and reachable by zoom): four links still do not
			   fit there, so let them wrap rather than overflow again. */
			flex-wrap: wrap;
			row-gap: 0.1rem;
		}
		.nav a {
			padding: 0.4rem 0.55rem;
			font-size: 0.9rem;
		}
		.nav .github {
			display: none;
		}
	}
</style>
